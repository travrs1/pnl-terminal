# You don't need to edit this by hand: the setup screen (Accounts & keys) writes .env for you.
# If you prefer, copy this file to .env and fill it in. Everything here stays on this machine.

# PORT=4200

# Coinbase: CDP API key with VIEW permission only (https://portal.cdp.coinbase.com/projects/api-keys)
# Either the newer Ed25519 key (key id + base64 secret) or legacy ECDSA (organizations/.../apiKeys/... + PEM)
COINBASE_KEY_NAME=
COINBASE_KEY_SECRET=

# Strike: API key from https://dashboard.strike.me with the balance-read scope only
STRIKE_API_KEY=

# Schwab: app from https://developer.schwab.com (product: "Accounts and Trading Production")
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Solana RPC: optional but recommended (free key: https://dashboard.helius.dev)
# e.g. https://mainnet.helius-rpc.com/?api-key=XXXX
SOLANA_RPC_URL=
